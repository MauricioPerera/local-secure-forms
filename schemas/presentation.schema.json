{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-secure-forms.dev/schemas/presentation.schema.json",
  "title": "LSFA Declarative Presentation 0.3",
  "type": "object",
  "required": ["mode"],
  "additionalProperties": false,
  "properties": {
    "mode": {"enum": ["auto", "form", "terminal", "headless", "manual"]},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$(?![\\s\\S])"},
    "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$(?![\\s\\S])"},
    "theme": {"enum": ["system", "light", "dark", "high_contrast"]},
    "layout": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "title", "fields"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])"},
              "title": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"},
              "fields": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"}},
              "collapsed": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "not": {"required": ["profile", "layout"]}
}
