{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-secure-forms.dev/schemas/request.schema.json",
  "title": "LSFA Request",
  "type": "object",
  "required": ["operation", "purpose", "fields", "validation", "expires_in_seconds"],
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$(?![\\s\\S])"},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$(?![\\s\\S])"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "risk": {"enum": ["low", "medium", "high", "irreversible"]},
    "initiator": {"enum": ["user", "agent", "system"]},
    "presentation": {"oneOf": [
      {"enum": ["auto", "form", "terminal", "headless", "manual"]},
      {"$ref": "presentation.schema.json"}
    ]},
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["name", "type", "sensitivity"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"},
          "type": {"enum": ["text", "multiline", "email", "email_list", "hostname", "integer", "boolean", "secret", "opaque_reference", "safe_local_path"]},
          "sensitivity": {"enum": ["public", "private", "secret"]},
          "required": {"type": "boolean"},
          "default": {"type": ["string", "integer", "boolean", "array"]}
        },
        "allOf": [
          {"if": {"properties": {"sensitivity": {"enum": ["secret", "private"]}}}, "then": {"not": {"required": ["default"]}}},
          {"if": {"properties": {"type": {"const": "secret"}}}, "then": {"properties": {"sensitivity": {"const": "secret"}}}},
          {"if": {"properties": {"type": {"const": "integer"}}}, "then": {"properties": {"default": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}}}},
          {"if": {"properties": {"type": {"const": "boolean"}}}, "then": {"properties": {"default": {"type": "boolean"}}}},
          {"if": {"properties": {"type": {"enum": ["text", "multiline", "email", "hostname", "opaque_reference", "safe_local_path"]}}}, "then": {"properties": {"default": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"}}}},
          {"if": {"properties": {"type": {"const": "email_list"}}}, "then": {"properties": {"default": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "maxLength": 254, "pattern": "^[^\\s@<>\\u0000-\\u001f]+@[^\\s@<>\\u0000-\\u001f]+\\.[^\\s@<>\\u0000-\\u001f]+$(?![\\s\\S])"}}}}}
        ]
      }
    },
    "validation": {"type": "object", "required": ["preflight"], "additionalProperties": false, "properties": {
      "preflight": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$(?![\\s\\S])"},
      "on_failure": {"const": "do_not_store"}
    }},
    "confirmation": {"$ref": "confirmation.schema.json"},
    "expires_in_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
  },
  "allOf": [
    {"$ref": "lifecycle.schema.json#/$defs/riskPolicy"},
    {"if": {"required": ["risk"], "properties": {"risk": {"const": "high"}}},
     "then": {"required": ["confirmation"], "properties": {"confirmation": {"properties": {"method": {"enum": ["pin", "pin_and_totp"]}}}}}},
    {"if": {"required": ["risk"], "properties": {"risk": {"const": "irreversible"}}},
     "then": {"required": ["confirmation"], "properties": {"confirmation": {"properties": {"method": {"const": "pin_and_totp"}}}}}},
    {"if": {"properties": {"operation": {"const": "purge"}}},
     "then": {"required": ["risk", "confirmation"], "properties": {"risk": {"const": "irreversible"}, "confirmation": {"properties": {"method": {"const": "pin_and_totp"}}}}}}
  ]
}
