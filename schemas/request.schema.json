{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-secure-forms.dev/schemas/request.schema.json",
  "title": "LSFA Request",
  "type": "object",
  "required": ["operation", "purpose", "fields", "validation", "expires_in_seconds"],
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "operation": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "irreversible"]},
    "initiator": {"enum": ["user", "agent", "system"]},
    "presentation": {"enum": ["auto", "form", "terminal", "headless", "manual"]},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "sensitivity"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
          "type": {"type": "string", "minLength": 1},
          "sensitivity": {"enum": ["public", "private", "secret"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "validation": {"type": "object", "minProperties": 1},
    "confirmation": {"type": "object"},
    "expires_in_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
  }
}
